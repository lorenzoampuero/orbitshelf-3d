# OrbitShelf 3D — environment template. Copy to `.env.local` and fill in locally. NEVER commit real values.
# Next.js loads `.env.local` automatically.

# ── Provider: Sloyd (server-side only, never exposed to the browser) ─────────────────────────────
# Leave empty to run in DEMO mode (sample GLBs only, no AI generation).
SLOYD_CLIENT_ID=
SLOYD_CLIENT_SECRET=

# ── Provider: fal (server-side only). Every fal engine stays off until it is listed in ENGINES_ENABLED. ───
# Not used until real engine tests are authorised. fal's terms need written confirmation before reselling (docs/AUDITORIA_ESTADO_ACTUAL.md).
FAL_KEY=
# Comma-separated engine ids to pilot, e.g. fal-rodin-2.5. Kill switch: ENGINES_DISABLED always wins.
ENGINES_ENABLED=
ENGINES_DISABLED=

# ── Provider: Meshy (server-side only). Off until meshy-7.1 is listed in ENGINES_ENABLED. Needs a plan with API access. ───
MESHY_API_KEY=

# ── Shopify (server-side only). See docs/SHOPIFY.md. Off while empty. ───────────────────────────
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Encrypts store tokens. 32+ random characters. If it is lost, stores must reconnect.
INTEGRATIONS_KEY=

# Starting paid jobs through /api/v1. Keep off until fal's terms are confirmed in writing.
API_GENERATION_ENABLED=

# ── Sign-in with Supabase (magic link) ──────────────────────────────────────────────────────────
# When both are set, users sign in with an emailed link. Use the PUBLISHABLE key (sb_publishable_…), never the secret key.
# In Supabase → Authentication → URL Configuration, set the Site URL and add <your-site>/auth/callback to Redirect URLs.
# Behind a TLS-inspecting proxy or antivirus, start Node with NODE_OPTIONS=--use-system-ca.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Set to "local" to force the passwordless local sign-in even when Supabase is configured (tests, offline dev).
AUTH_MODE=

# ── Session (local development sign-in) ─────────────────────────────────────────────────────────
# 32+ random characters. If empty in development a random secret is generated into .data/session-secret.
SESSION_SECRET=
# Local sign-in has no passwords. It is disabled when NODE_ENV=production unless you explicitly set this to "true".
ALLOW_LOCAL_AUTH=

# ── Cost / abuse controls for paid provider jobs ────────────────────────────────────────────────
# How a job is charged: "credits" (the default: a job costs what its engine costs) or "attempts" (every job counts one).
# attempts is only a testing cap and is only safe with ONE engine on: with two engines on, the server refuses to quote or start jobs
# (unless ORBITSHELF_TEST=1), because flat attempts break the 60% margin floor (docs/SIMULACION_PLANES.md, src/lib/credits.ts).
BILLING_UNIT=credits
# Starting credits a new local workspace receives once when BILLING_UNIT is credits (default 100: a few jobs on any engine). Test credits, never sold.
LOCAL_FREE_CREDITS=100
# Starting attempts a new local workspace receives once when BILLING_UNIT=attempts (safety cap, not a purchased balance).
LOCAL_PAID_ATTEMPT_CAP=300
# Maximum simultaneously running provider jobs per workspace (Sloyd allows 5 per API key while in test).
MAX_ACTIVE_JOBS_PER_ORG=2

# ── Site ────────────────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Legal operator (shown on /privacy, /terms and in the footer) ────────────────────────────────
# Required before any public launch. The legal pages show a "not configured" notice while these are empty.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_TAX_ID=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_COUNTRY=
NEXT_PUBLIC_LEGAL_JURISDICTION=

# ── Rate limiting behind a proxy ─────────────────────────────────────────────────────────────────
# Name of the header your hosting proxy sets to the real client IP (e.g. "x-real-ip" on Vercel).
# Leave empty when not behind a trusted proxy: forwarding headers are then ignored because clients can forge them.
TRUSTED_IP_HEADER=

# ── Production data (optional in development) ───────────────────────────────────────────────────
# Postgres connection string. Contains a password: only ever put it in this file, never in chat or a commit.
# When empty the app uses the local JSON store below, which only works on a single server.
DATABASE_URL=
# Supabase secret key (sb_secret_…), used only by the server for the private file bucket. Never in the browser, in chat or in a commit.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=orbitshelf-private
# Protects POST /api/internal/poll, for hosts that wake the job checker from a scheduler. 32+ random characters.
CRON_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────────────────────────
# Where the local adapter keeps its private JSON db and GLB/image files. Defaults to ./.data
DATA_DIR=

# ── Test-only overrides (used by the Playwright mock provider; do not set in real use) ─────────
# SLOYD_API_BASE_URL=http://127.0.0.1:4010/api
# SLOYD_RESULT_BASE_URL=http://127.0.0.1:4010/results/
# Only read when ORBITSHELF_TEST=1:
# FAL_QUEUE_BASE_URL=http://127.0.0.1:3999/fal
# FAL_RESULT_HOSTS=127.0.0.1
